# Copy to build.env (git-ignored) and fill in. Values here end up in the firmware image.

# --- OpenWrt target --------------------------------------------------------
RELEASE=25.12.6
TARGET=ath79/generic
PROFILE=tplink_archer-c6-v2
# Extra packages; prefix with "-" to remove a default package.
PACKAGES="kmod-wireguard wireguard-tools luci-proto-wireguard"

# --- Network ------------------------------------------------------------------
HOSTNAME=OpenWrt
LAN_IP=192.168.1.1
# Extra DNS names that resolve to the router (e.g. the vendor URL printed on the label)
LAN_ALIASES="tplinkwifi.net"

# WAN: dhcp or pppoe. WAN_VLAN is an optional 802.1Q tag (e.g. 848 for CETIN in Czechia).
WAN_PROTO=dhcp
WAN_VLAN=
PPPOE_USER=
PPPOE_PASS=

# Wi-Fi (same SSID/key on all radios). Leave WIFI_SSID empty to keep Wi-Fi off.
WIFI_SSID=
WIFI_KEY=
WIFI_COUNTRY=CZ

# SSH public key(s) for root; password login is disabled when set.
SSH_AUTHORIZED_KEYS_FILE=~/.ssh/id_ed25519.pub

# --- Bridge -----------------------------------------------------------------------
# Your private bridge config (set "storage": "/etc/tuya-homekit-bridge/db" and
# "interfaces": ["br-lan"]) and, optionally, an existing pairing directory so a
# factory reset of the router restores the HomeKit pairing too.
BRIDGE_CONFIG=../config.json
BRIDGE_DB=
# Use the uncompressed asset: its code is mapped straight from /tmp, while the .upx
# variant is unpacked into extra RAM (measured ~5 MB more free memory without UPX).
# Release asset(s) to download into RAM at boot, tried in order, pinned by SHA-256.
# The raw.githubusercontent.com / jsDelivr mirrors (bin branch) help on networks
# that cannot reach github.com release downloads.
BRIDGE_URL="https://github.com/omaxim/tuya-homekit-bridge/releases/download/v0.2.0/tuya-homekit-bridge-linux-mips-softfloat https://raw.githubusercontent.com/omaxim/tuya-homekit-bridge/bin/v0.2.0/tuya-homekit-bridge-linux-mips-softfloat https://cdn.jsdelivr.net/gh/omaxim/tuya-homekit-bridge@bin/v0.2.0/tuya-homekit-bridge-linux-mips-softfloat"
BRIDGE_SHA256=

# --- Optional extras ------------------------------------------------------------------
# Second Wi-Fi network (e.g. the SSID/key printed on the router label).
WIFI2_SSID=
WIFI2_SSID_5G=
WIFI2_KEY=
# Root password for the web UI / console. Leave empty to be asked on first login.
ROOT_PASSWORD=
# File with extra uci commands appended to the first-boot script (site-specific tweaks,
# e.g. a second LAN address for the web UI). Runs before "uci commit".
EXTRA_UCI_DEFAULTS=
