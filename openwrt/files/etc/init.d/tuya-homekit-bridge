#!/bin/sh /etc/rc.common
# tuya-homekit-bridge: Tuya devices -> Apple HomeKit
START=99
STOP=10
USE_PROCD=1

start_service() {
	[ -f /etc/tuya-homekit-bridge/config.json ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/tuya-homekit-bridge-run
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
