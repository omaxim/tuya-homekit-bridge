#!/bin/sh
# Runs tuya-homekit-bridge from RAM.
#
# Routers with 8 MB flash have no room for the ~2.4 MB binary, so it is
# downloaded to /tmp (RAM) at boot and verified against a pinned SHA-256
# before it is executed. Settings: /etc/tuya-homekit-bridge/loader.conf
#   URL="<url> [<fallback url> ...]"   (tried in order)
#   SHA256=<sha256 of the asset>
# If the binary is installed on flash at /usr/bin/tuya-homekit-bridge, it is used instead.

CONF=/etc/tuya-homekit-bridge
BIN=/tmp/tuya-homekit-bridge
log() { logger -t tuya-homekit-bridge "$*"; }

sync_clock() {
	# Routers have no RTC; TLS fails until the clock is right.
	[ "$(date +%Y)" -ge 2026 ] && return 0
	for s in $(uci -q get system.ntp.server) pool.ntp.org; do
		ntpd -q -n -p "$s" >/dev/null 2>&1 && return 0
	done
	return 1
}

verify() { [ -n "$SHA256" ] && [ "$(sha256sum "$1" 2>/dev/null | cut -d' ' -f1)" = "$SHA256" ]; }

if [ -x /usr/bin/tuya-homekit-bridge ]; then
	BIN=/usr/bin/tuya-homekit-bridge
else
	. "$CONF/loader.conf"
	until verify "$BIN"; do
		sync_clock
		for u in $URL; do
			rm -f "$BIN.part"
			if uclient-fetch -q -T 30 -O "$BIN.part" "$u" && verify "$BIN.part"; then
				chmod 755 "$BIN.part" && mv "$BIN.part" "$BIN"
				log "downloaded and verified $u"
				break
			fi
			log "download or checksum failed: $u"
		done
		verify "$BIN" || { rm -f "$BIN.part"; sleep 30; }
	done
fi

exec "$BIN" -config "$CONF/config.json"
